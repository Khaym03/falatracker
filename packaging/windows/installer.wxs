<?xml version="1.0" encoding="UTF-8"?>

<?ifndef ProductVersion?>
  <?error ProductVersion property not defined?>
<?endif?>

<?ifndef BinPath?>
  <?error BinPath property not defined?>
<?endif?>

<?ifndef TemplatePath?>
  <?error TemplatePath property not defined?>
<?endif?>

<!-- Unique UpgradeCode and ProgramFiles target per architecture (cli/cli pattern) -->
<?if $(sys.BUILDARCH) = x64?>
  <?define UpgradeCode = "78AF0781-6C2B-42BD-83E5-20EF45513533"?>
  <?define ProgramFilesTarget = "ProgramFiles64Folder"?>
<?elseif $(sys.BUILDARCH) = arm64?>
  <?define UpgradeCode = "E16CD0E7-176F-4FDC-A263-7FAF6172CCC6"?>
  <?define ProgramFilesTarget = "ProgramFiles64Folder"?>
<?elseif $(sys.BUILDARCH) = x86?>
  <?define UpgradeCode = "C6D38CDE-B3DE-457F-B120-1AB6DE6CC6B3"?>
  <?define ProgramFilesTarget = "ProgramFilesFolder"?>
<?else?>
  <?error Unsupported target architecture: $(sys.BUILDARCH)?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="FalaTracker"
           Manufacturer="FalaTracker"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="Monitors Falabella Business Center purchase orders and downloads Excel reports"
                        Manufacturer="FalaTracker" />

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of !(bind.Property.ProductName) is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Installation layout: C:\Program Files\FalaTracker\ -->
    <StandardDirectory Id="$(var.ProgramFilesTarget)">
      <Directory Id="INSTALLFOLDER" Name="FalaTracker">
        <Directory Id="TemplatesFolder" Name="templates" />
      </Directory>
    </StandardDirectory>

    <!-- Restore INSTALLFOLDER if previously persisted to HKLM registry -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="InstallDirSearch"
                      Root="HKLM"
                      Key="SOFTWARE\FalaTracker"
                      Name="InstallDir"
                      Type="directory" />
    </Property>

    <Feature Id="DefaultFeature"
             Title="FalaTracker"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <ComponentGroup Id="ProductComponents">
      <Component Id="AppBinary" Directory="INSTALLFOLDER">
        <File Id="AppExe"
              Name="falatracker.exe"
              Source="$(var.BinPath)"
              KeyPath="yes" />

        <Environment Id="AppSystemPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Action="set"
                     Part="last"
                     System="yes"
                     Permanent="no" />

        <fw:FirewallException Id="AppFirewallInPrivate"
                              Name="FalaTracker (Inbound - Private)"
                              Description="Allows inbound TCP traffic to FalaTracker on private networks."
                              Program="[#AppExe]"
                              Protocol="tcp"
                              Outbound="no"
                              Profile="private"
                              Scope="any"
                              IgnoreFailure="yes" />

        <fw:FirewallException Id="AppFirewallInDomain"
                              Name="FalaTracker (Inbound - Domain)"
                              Description="Allows inbound TCP traffic to FalaTracker on corporate domain networks."
                              Program="[#AppExe]"
                              Protocol="tcp"
                              Outbound="no"
                              Profile="domain"
                              Scope="any"
                              IgnoreFailure="yes" />

        <fw:FirewallException Id="AppFirewallOutPrivate"
                              Name="FalaTracker (Outbound - Private)"
                              Description="Allows outbound TCP traffic from FalaTracker on private networks."
                              Program="[#AppExe]"
                              Protocol="tcp"
                              Outbound="yes"
                              Profile="private"
                              Scope="any"
                              IgnoreFailure="yes" />

        <fw:FirewallException Id="AppFirewallOutDomain"
                              Name="FalaTracker (Outbound - Domain)"
                              Description="Allows outbound TCP traffic from FalaTracker on corporate domain networks."
                              Program="[#AppExe]"
                              Protocol="tcp"
                              Outbound="yes"
                              Profile="domain"
                              Scope="any"
                              IgnoreFailure="yes" />
      </Component>

      <!-- Bundled Excel template resolved relative to falatracker.exe -->
      <Component Id="StandardTemplate" Directory="TemplatesFolder">
        <File Id="StandardTemplateXlsx"
              Name="standard.xlsx"
              Source="$(var.TemplatePath)"
              KeyPath="yes" />
      </Component>

      <!-- Persist INSTALLFOLDER so future upgrades remember custom install paths -->
      <Component Id="PersistInstallDir" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\FalaTracker"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Broadcast WM_SETTINGCHANGE immediately so new PATH takes effect without reboot -->
    <util:BroadcastEnvironmentChange />

    <!-- Interactive install wizard (automatically skipped during silent /qn GPO/Intune deploys) -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
